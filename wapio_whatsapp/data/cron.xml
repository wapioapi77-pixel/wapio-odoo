<odoo noupdate="1">
    <record id="cron_dispatch" model="ir.cron">
        <field name="name">Wapio: submit queued messages</field>
        <field name="model_id" ref="model_wapio_message"/>
        <field name="state">code</field><field name="code">model._cron_dispatch()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field><field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
